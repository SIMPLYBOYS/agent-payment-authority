# Copy to .env (ignored by git). Placeholders only.
# Never put subscription tokens, OAuth material, private keys or grants here:
# Claude Code login is done separately through the official CLI flow.

# Required. Loopback IP literal and port (127.0.0.1 or [::1]).
# 8123 is reserved for the WebAuthn spike origin; do not reuse it.
APA_ADDR=127.0.0.1:8402

# Optional, default false. true is rejected until the Buyer wrapper (B1-04) exists.
APA_LIVE_CLI=false
