# Local settings and secrets
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.keystore
keys/
secrets/
credentials/

# Build output and runtime data
bin/
var/
artifacts/
*.log
__pycache__/
*.pyc

# Raw Claude Code CLI output (only masked, typed events may be kept)
cli-raw/
*.cli-raw.*

# Audio and biometric samples
*.wav
*.mp3
*.m4a
*.flac
*.ogg
*.webm

# Licensed LimeZu assets stay local; placeholders are tracked elsewhere
assets/limezu/
**/limezu/

# Unity project (B1-06 delivery 2): only Assets (own files and .meta),
# Packages and ProjectSettings are tracked. The copied LimeZu files and the
# Web build that contains them stay local (LimeZu licence: no distribution).
unity/AgentPaymentAuthority/Library/
unity/AgentPaymentAuthority/Temp/
unity/AgentPaymentAuthority/Logs/
unity/AgentPaymentAuthority/UserSettings/
unity/AgentPaymentAuthority/obj/
unity/AgentPaymentAuthority/Build/
unity/AgentPaymentAuthority/Builds/
unity/AgentPaymentAuthority/Assets/LimeZu/
unity/AgentPaymentAuthority/Assets/LimeZu.meta
# The scene is generated by ShopBuilder after the LimeZu import: it refers
# to the imported (ignored) files, so a committed copy would open on one
# machine only. Rebuild it with: sh scripts/unity/unity.sh scene OUT
unity/AgentPaymentAuthority/Assets/Scenes/
unity/AgentPaymentAuthority/Assets/Scenes.meta
unity/AgentPaymentAuthority/*.csproj
unity/AgentPaymentAuthority/*.sln
unity/AgentPaymentAuthority/.vs/

# Versioned, non-sensitive fixtures live in testdata/ and stay tracked.

.DS_Store
