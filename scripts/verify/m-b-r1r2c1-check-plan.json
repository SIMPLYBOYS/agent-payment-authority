[
 {
  "name": "vet",
  "cmd": [
   "go",
   "vet",
   "./cmd/demo",
   "./cmd/timing-judge",
   "./internal/timing"
  ],
  "timeout": 300000000000,
  "kind": "plain"
 },
 {
  "name": "go-race-timing-judge",
  "cmd": [
   "go",
   "test",
   "-json",
   "-count=1",
   "-race",
   "./internal/timing",
   "./cmd/timing-judge"
  ],
  "timeout": 600000000000,
  "kind": "go"
 },
 {
  "name": "go-race-demo-runs",
  "cmd": [
   "go",
   "test",
   "-json",
   "-count=1",
   "-race",
   "-run",
   "^(TestStopIsolation|TestTimingInterleaved|TestHostStopWithTwoRuns|TestCapacityAndStopping|TestTwoRunsAtOnce)$",
   "./cmd/demo"
  ],
  "timeout": 900000000000,
  "kind": "go"
 },
 {
  "name": "node",
  "cmd": [
   "node",
   "--test",
   "web/test/adapter.test.mjs",
   "web/test/hostcreds.test.mjs",
   "web/test/scene.test.mjs"
  ],
  "timeout": 180000000000,
  "kind": "plain"
 },
 {
  "name": "reverse-selftest",
  "cmd": [
   "python3",
   "-I",
   "scripts/verify/m_b_reverse_test.py"
  ],
  "timeout": 60000000000,
  "kind": "plain"
 },
 {
  "name": "dual-ui",
  "cmd": [
   "node",
   "scripts/verify/dual-ui.mjs",
   "--out",
   "{dir}/dual-ui"
  ],
  "timeout": 900000000000,
  "kind": "plain"
 },
 {
  "name": "history-ui",
  "cmd": [
   "node",
   "scripts/verify/history-ui.mjs",
   "--out",
   "{dir}/history-ui"
  ],
  "timeout": 900000000000,
  "kind": "plain"
 },
 {
  "name": "browser-ui",
  "cmd": [
   "node",
   "scripts/verify/browser-ui.mjs",
   "--out",
   "{dir}/browser-ui"
  ],
  "timeout": 1500000000000,
  "kind": "plain"
 },
 {
  "name": "reverse",
  "cmd": [
   "python3",
   "-u",
   "scripts/verify/m-b-reverse.py",
   "--out",
   "{dir}/reverse",
   "^(R1|R2|C1):"
  ],
  "timeout": 1800000000000,
  "kind": "reverse"
 }
]