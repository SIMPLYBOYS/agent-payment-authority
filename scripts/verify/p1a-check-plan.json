[
 {
  "name": "go-targeted",
  "cmd": [
   "go",
   "test",
   "-json",
   "-count=1",
   "-skip",
   "^TestTimingInterleaved$",
   "./internal/contracts/",
   "./internal/policy/",
   "./internal/paycontract/",
   "./internal/paypolicy/",
   "./internal/signer/",
   "./internal/store/",
   "./internal/toolbridge/",
   "./internal/m1evidence/",
   "./internal/verification/",
   "./internal/buyer/",
   "./cmd/m1-check/",
   "./cmd/demo/"
  ],
  "timeout": 1200000000000,
  "kind": "go"
 },
 {
  "name": "go-race",
  "cmd": [
   "go",
   "test",
   "-json",
   "-race",
   "-count=1",
   "./internal/paycontract/",
   "./internal/paypolicy/",
   "./internal/signer/",
   "./internal/policy/",
   "./internal/store/",
   "./internal/toolbridge/",
   "-run",
   "Pay|Rules|Golden|SameFields|Binding|Decision|Grant|Event|Stub|Upgrade|M1Evidence"
  ],
  "timeout": 900000000000,
  "kind": "go"
 },
 {
  "name": "go-race-demo",
  "cmd": [
   "go",
   "test",
   "-json",
   "-race",
   "-count=1",
   "./cmd/demo/",
   "-run",
   "^TestP1a"
  ],
  "timeout": 900000000000,
  "kind": "go"
 },
 {
  "name": "vet",
  "cmd": [
   "go",
   "vet",
   "./..."
  ],
  "timeout": 600000000000,
  "kind": "plain"
 },
 {
  "name": "node",
  "cmd": [
   "node",
   "--test",
   "web/test/adapter.test.mjs",
   "web/test/hostcreds.test.mjs",
   "web/test/scene.test.mjs",
   "web/test/p1a.test.mjs"
  ],
  "timeout": 180000000000,
  "kind": "plain"
 },
 {
  "name": "contract-vectors",
  "cmd": [
   "node",
   "scripts/check-contract-vectors.mjs"
  ],
  "timeout": 120000000000,
  "kind": "plain"
 },
 {
  "name": "m1-fixture-bundle",
  "cmd": [
   "sh",
   "-c",
   "set -u; b=artifacts/m1/m1-fixture-20261009T162703Z-4ddb7a; h() { find \"$b\" -type f -print0 | LC_ALL=C sort -z | xargs -0 shasum -a 256; }; h > {dir}/fixture.before.sha256; go run -buildvcs=true ./cmd/verify-demo --run-dir \"$b\" --mode fixture > {dir}/fixture.report.json; e=$?; h > {dir}/fixture.after.sha256; cmp -s {dir}/fixture.before.sha256 {dir}/fixture.after.sha256 || { echo 'the bundle changed'; exit 9; }; echo \"verify-demo exit $e; bundle files unchanged ($(wc -l < {dir}/fixture.before.sha256) files)\"; exit $e"
  ],
  "timeout": 600000000000,
  "kind": "plain"
 },
 {
  "name": "m1-live-bundle",
  "cmd": [
   "sh",
   "-c",
   "set -u; b=artifacts/m1/m1-live-20261010T173831Z-9d32ef; h() { find \"$b\" -type f -print0 | LC_ALL=C sort -z | xargs -0 shasum -a 256; }; h > {dir}/live.before.sha256; go run -buildvcs=true ./cmd/verify-demo --run-dir \"$b\" --mode live > {dir}/live.report.json; e=$?; h > {dir}/live.after.sha256; cmp -s {dir}/live.before.sha256 {dir}/live.after.sha256 || { echo 'the bundle changed'; exit 9; }; echo \"verify-demo exit $e; bundle files unchanged ($(wc -l < {dir}/live.before.sha256) files)\"; exit $e"
  ],
  "timeout": 600000000000,
  "kind": "plain"
 },
 {
  "name": "reverse-selftest",
  "cmd": [
   "python3",
   "-I",
   "scripts/verify/m_b_reverse_test.py"
  ],
  "timeout": 60000000000,
  "kind": "plain"
 },
 {
  "name": "p1a-ui",
