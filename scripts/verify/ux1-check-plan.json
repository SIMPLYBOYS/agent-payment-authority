[
 {
  "name": "node",
  "cmd": [
   "node",
   "--test",
   "web/test/adapter.test.mjs",
   "web/test/hostcreds.test.mjs",
   "web/test/scene.test.mjs"
  ],
  "timeout": 180000000000,
  "kind": "plain"
 },
 {
  "name": "reverse-selftest",
  "cmd": [
   "python3",
   "-I",
   "scripts/verify/m_b_reverse_test.py"
  ],
  "timeout": 60000000000,
  "kind": "plain"
 },
 {
  "name": "unity",
  "cmd": [
   "sh",
   "scripts/unity/unity.sh",
   "test",
   "{dir}/unity"
  ],
  "timeout": 900000000000,
  "kind": "plain"
 },
 {
  "name": "webgl",
  "cmd": [
   "sh",
   "scripts/unity/unity.sh",
   "webgl",
   "{dir}/webgl"
  ],
  "timeout": 1200000000000,
  "kind": "plain"
 },
 {
  "name": "webgl-hashes",
  "cmd": [
   "sh",
   "-c",
   "shasum -a 256 unity/AgentPaymentAuthority/Build/WebGL/Build/WebGL.data unity/AgentPaymentAuthority/Build/WebGL/Build/WebGL.framework.js unity/AgentPaymentAuthority/Build/WebGL/Build/WebGL.loader.js unity/AgentPaymentAuthority/Build/WebGL/Build/WebGL.wasm > {dir}/webgl.sha256 && cat {dir}/webgl.sha256"
  ],
  "timeout": 60000000000,
  "kind": "plain"
 },
 {
  "name": "ux1-ui",
  "cmd": [
   "node",
   "scripts/verify/ux1-ui.mjs",
   "--out",
   "{dir}/ux1-ui"
  ],
  "timeout": 900000000000,
  "kind": "plain"
 },
 {
