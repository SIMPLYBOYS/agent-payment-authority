{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"urn:apa:m1:v2",
  "title":"Agent Payment Authority M1 fixture contracts (apa.m1.v2)",
  "$comment":"Shape only. Go Validate methods enforce uint64 bounds, ownership, hashes, the event chain, transition rules, cross-field semantics and evidence constraints. No payment authority is conveyed by this schema. v2 supersedes the never-accepted v1; a production payment contract is named separately.",
  "oneOf":[{"$ref":"#/$defs/PurchaseOrder"},{"$ref":"#/$defs/RegistryConfig"},{"$ref":"#/$defs/AuditEvent"},{"$ref":"#/$defs/PolicyDecision"},{"$ref":"#/$defs/CaseManifest"},{"$ref":"#/$defs/RunManifest"}],
  "$defs":{
    "Version":{"const":"apa.m1.v2"},
    "ID":{"type":"string","pattern":"^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"},
    "Amount":{"type":"string","pattern":"^(0|[1-9][0-9]*)$","maxLength":20},
    "Chain":{"type":"string","pattern":"^[1-9][0-9]*$","maxLength":20},
    "Address":{"type":"string","pattern":"^0x[0-9a-f]{40}$"},
    "Digest":{"type":"string","pattern":"^sha256:[0-9a-f]{64}$"},
    "Time":{"type":"integer","minimum":1,"maximum":253402300799},
    "Mode":{"enum":["fixture","live","replay"]},
    "ApprovalStatus":{"enum":["pending","not_requested","expired","withdrawn"]},
    "Label":{"type":"string","minLength":1,"maxLength":64},
    "Consumer":{"type":"object","additionalProperties":false,"required":["consumer_id","agent_id","wallet_id"],"properties":{"consumer_id":{"$ref":"#/$defs/ID"},"agent_id":{"$ref":"#/$defs/ID"},"wallet_id":{"$ref":"#/$defs/ID"}}},
    "WalletRef":{"type":"object","additionalProperties":false,"required":["wallet_id","chain_id","from","evidence_mode"],"properties":{"wallet_id":{"$ref":"#/$defs/ID"},"chain_id":{"$ref":"#/$defs/Chain"},"from":{"$ref":"#/$defs/Address"},"evidence_mode":{"const":"fixture"}}},
    "Asset":{"type":"object","additionalProperties":false,"required":["asset_id","chain_id","asset_contract","decimals","eip712_name","eip712_version"],"properties":{"asset_id":{"$ref":"#/$defs/ID"},"chain_id":{"$ref":"#/$defs/Chain"},"asset_contract":{"$ref":"#/$defs/Address"},"decimals":{"type":"integer","minimum":0,"maximum":77},"eip712_name":{"$ref":"#/$defs/Label"},"eip712_version":{"$ref":"#/$defs/Label"}}},
    "Task":{"type":"object","additionalProperties":false,"required":["version","task_id","consumer_id","agent_id","wallet_id","status","created_at"],"properties":{"version":{"$ref":"#/$defs/Version"},"task_id":{"$ref":"#/$defs/ID"},"consumer_id":{"$ref":"#/$defs/ID"},"agent_id":{"$ref":"#/$defs/ID"},"wallet_id":{"$ref":"#/$defs/ID"},"status":{"enum":["created","running","awaiting_approval","denied","cancelled","failed"]},"created_at":{"$ref":"#/$defs/Time"}}},
    "RegistryConfig":{"type":"object","additionalProperties":false,"required":["version","consumers","wallets","assets","tasks","merchant_pay_to"],"properties":{"version":{"$ref":"#/$defs/Version"},"consumers":{"type":"array","minItems":1,"items":{"$ref":"#/$defs/Consumer"}},"wallets":{"type":"array","minItems":1,"items":{"$ref":"#/$defs/WalletRef"}},"assets":{"type":"array","minItems":1,"items":{"$ref":"#/$defs/Asset"}},"tasks":{"type":"array","items":{"$ref":"#/$defs/Task"}},"merchant_pay_to":{"$ref":"#/$defs/Address"}}},
    "AuthorizationIntent":{
      "type":"object","additionalProperties":false,
      "required":["version","domain","consumer_id","agent_id","wallet_id","task_id","purchase_order_id","resource_hash","http_method","resource_url","x402_version","scheme","payment_requirement_hash","chain_id","asset_contract","from","pay_to","amount","valid_after","valid_before","eip3009_nonce"],
      "properties":{
        "version":{"$ref":"#/$defs/Version"},"domain":{"const":"agent-payment-authority/m1-fixture/v2/verifier-not-deployed"},
        "consumer_id":{"$ref":"#/$defs/ID"},"agent_id":{"$ref":"#/$defs/ID"},"wallet_id":{"$ref":"#/$defs/ID"},"task_id":{"$ref":"#/$defs/ID"},"purchase_order_id":{"$ref":"#/$defs/ID"},
        "resource_hash":{"$ref":"#/$defs/Digest"},"http_method":{"enum":["GET","POST"]},"resource_url":{"type":"string","format":"uri","pattern":"^https?://[^#]*$"},"x402_version":{"const":2},"scheme":{"const":"exact"},
        "payment_requirement_hash":{"$ref":"#/$defs/Digest"},"chain_id":{"$ref":"#/$defs/Chain"},"asset_contract":{"$ref":"#/$defs/Address"},"from":{"$ref":"#/$defs/Address"},"pay_to":{"$ref":"#/$defs/Address"},"amount":{"$ref":"#/$defs/Amount"},
        "valid_after":{"$ref":"#/$defs/Time"},"valid_before":{"$ref":"#/$defs/Time"},"eip3009_nonce":{"type":"string","pattern":"^0x[0-9a-f]{64}$"}
      }
    },
    "Quote":{"type":"object","additionalProperties":false,"required":["x402_version","selected_requirement","extensions"],"properties":{"x402_version":{"const":2},"selected_requirement":{"type":"object","required":["scheme","network","asset","payTo","amount"],"additionalProperties":true,"properties":{"scheme":{"const":"exact"},"network":{"type":"string","pattern":"^eip155:[1-9][0-9]*$"},"asset":{"$ref":"#/$defs/Address"},"payTo":{"$ref":"#/$defs/Address"},"amount":{"$ref":"#/$defs/Amount"},"extra":{"type":"object","additionalProperties":true,"properties":{"assetTransferMethod":{"const":"eip3009"}}}}},"extensions":{"type":"object","additionalProperties":true}}},
    "PurchaseOrder":{"type":"object","additionalProperties":false,"required":["version","request_id","intent","quote"],"properties":{"version":{"$ref":"#/$defs/Version"},"request_id":{"$ref":"#/$defs/ID"},"intent":{"$ref":"#/$defs/AuthorizationIntent"},"quote":{"$ref":"#/$defs/Quote"}}},
    "PolicyDecision":{"type":"object","additionalProperties":false,"required":["version","intent_hash","policy_verdict","approval_status","payment_status","reason"],"properties":{"version":{"$ref":"#/$defs/Version"},"intent_hash":{"$ref":"#/$defs/Digest"},"policy_verdict":{"enum":["Ask","Deny","Allow"]},"approval_status":{"$ref":"#/$defs/ApprovalStatus"},"payment_status":{"const":"unavailable"},"reason":{"$ref":"#/$defs/ID"}}},
    "EventScope":{"type":"object","additionalProperties":false,"required":["consumer_id","agent_id","wallet_id","task_id"],"properties":{"consumer_id":{"$ref":"#/$defs/ID"},"agent_id":{"$ref":"#/$defs/ID"},"wallet_id":{"$ref":"#/$defs/ID"},"task_id":{"$ref":"#/$defs/ID"},"purchase_order_id":{"$ref":"#/$defs/ID"},"intent_hash":{"$ref":"#/$defs/Digest"}}},
    "EventPayload":{"type":"object","additionalProperties":false,"properties":{"code":{"$ref":"#/$defs/ID"},"decision":{"$ref":"#/$defs/PolicyDecision"},"delegation_id":{"not":{},"description":"apa.pay.v1 only; never present in an M1 value"},"approval_session_id":{"not":{},"description":"apa.pay.v1 only; never present in an M1 value"},"grant_id":{"not":{},"description":"apa.pay.v1 only; never present in an M1 value"},"authorization_method":{"not":{},"description":"apa.pay.v1 only; never present in an M1 value"},"signer_approval_id":{"not":{},"description":"apa.pay.v1 only (A2); never present in an M1 value"},"credential":{"not":{},"description":"apa.pay.v2 only (C2); never present in an M1 value"},"payment":{"not":{},"description":"pay family only (P2); never present in an M1 value"},"run_conditions":{"not":{},"description":"pay family only (E1-a): TASK_STARTED; never present in an M1 value"}}},
    "AuditEvent":{"type":"object","additionalProperties":false,"required":["version","event_id","event_type","sequence","payload","evidence_mode","source","observed_at"],"properties":{"version":{"$ref":"#/$defs/Version"},"event_id":{"$ref":"#/$defs/ID"},"event_type":{"enum":["SYSTEM_READY","TASK_STARTED","PURCHASE_PROPOSED","POLICY_DECIDED","APPROVAL_EXPIRED","APPROVAL_WITHDRAWN","TASK_CANCELLED","TASK_TIMED_OUT","CLI_EXITED"]},"scope":{"$ref":"#/$defs/EventScope"},"sequence":{"type":"integer","minimum":0,"maximum":9007199254740991},"prev_event_hash":{"$ref":"#/$defs/Digest"},"payload":{"$ref":"#/$defs/EventPayload"},"evidence_mode":{"$ref":"#/$defs/Mode"},"source":{"$ref":"#/$defs/ID"},"observed_at":{"$ref":"#/$defs/Time"}}},
    "ExpectedOutcome":{"type":"object","additionalProperties":false,"required":["result","reason","approval_status","payment_status","budget_deducted","forbidden_events"],"properties":{"result":{"$ref":"#/$defs/ID"},"reason":{"$ref":"#/$defs/ID"},"approval_status":{"$ref":"#/$defs/ApprovalStatus"},"payment_status":{"const":"unavailable"},"budget_deducted":{"const":"0"},"forbidden_events":{"type":"array","items":{"$ref":"#/$defs/ID"},"minItems":4}}},
    "AcceptanceCase":{"type":"object","additionalProperties":false,"required":["case_id","layer","input_ref","operation","parameters","expected"],"properties":{"case_id":{"$ref":"#/$defs/ID"},"layer":{"enum":["contracts","integration"]},"input_ref":{"type":"string","minLength":1},"operation":{"enum":["advance-clock","binding","cancel","cli-timeout","compare-retry","policy","restart-and-new-task","validate-decision","validate-purchase"]},"parameters":{"type":"object","additionalProperties":{"type":"string"}},"expected":{"$ref":"#/$defs/ExpectedOutcome"}}},
    "CaseManifest":{"type":"object","additionalProperties":false,"required":["version","manifest_id","review_status","reviewer","defaults","cases"],"properties":{"version":{"$ref":"#/$defs/Version"},"manifest_id":{"$ref":"#/$defs/ID"},"review_status":{"enum":["pending","accepted"]},"reviewer":{"type":"string"},"defaults":{"type":"object","required":["remaining","allow_max","merchant","credential","required_config","mode","clock","asset"],"additionalProperties":false,"properties":{"remaining":{"$ref":"#/$defs/Amount"},"allow_max":{"$ref":"#/$defs/Amount"},"merchant":{"enum":["allowed","not_allowed"]},"credential":{"enum":["valid","expired"]},"required_config":{"enum":["present","missing"]},"mode":{"enum":["interactive","unattended"]},"clock":{"$ref":"#/$defs/Amount"},"asset":{"$ref":"#/$defs/ID"}}},"cases":{"type":"array","minItems":1,"items":{"$ref":"#/$defs/AcceptanceCase"}}}},
    "CommandResult":{"type":"object","additionalProperties":false,"required":["command","exit_code"],"properties":{"command":{"type":"string","minLength":1},"exit_code":{"type":"integer"}}},
    "EvidenceRef":{"type":"object","additionalProperties":false,"required":["evidence_id","path","digest","evidence_mode","source"],"properties":{"evidence_id":{"$ref":"#/$defs/ID"},"path":{"type":"string","minLength":1},"digest":{"$ref":"#/$defs/Digest"},"evidence_mode":{"$ref":"#/$defs/Mode"},"source":{"$ref":"#/$defs/ID"}}},
    "ClaimResult":{"type":"object","additionalProperties":false,"required":["case_id","verdict","evidence_ids","reason"],"properties":{"case_id":{"$ref":"#/$defs/ID"},"verdict":{"enum":["PASS","FAIL","INCONCLUSIVE"]},"evidence_ids":{"type":"array","items":{"$ref":"#/$defs/ID"}},"reason":{"type":"string","minLength":1}}},
    "RunManifest":{"type":"object","additionalProperties":false,"required":["version","run_id","code_commit","dirty_patch_digest","config_digest","case_manifest_digest","versions","commands","evidence","results","not_evaluated"],"properties":{"version":{"$ref":"#/$defs/Version"},"run_id":{"$ref":"#/$defs/ID"},"code_commit":{"$ref":"#/$defs/ID"},"dirty_patch_digest":{"$ref":"#/$defs/Digest"},"config_digest":{"$ref":"#/$defs/Digest"},"case_manifest_digest":{"$ref":"#/$defs/Digest"},"versions":{"type":"object","additionalProperties":{"type":"string"}},"commands":{"type":"array","minItems":1,"items":{"$ref":"#/$defs/CommandResult"}},"evidence":{"type":"array","items":{"$ref":"#/$defs/EvidenceRef"}},"results":{"type":"array","items":{"$ref":"#/$defs/ClaimResult"}},"not_evaluated":{"type":"array","items":{"$ref":"#/$defs/ID"}}}}
  }
}
